<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Needed on Android 12 only, where the user grants it in system settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- From Android 13 this is the permission for apps whose point is alarms.
         It is granted automatically, so a reminder set for 09:00 arrives at
         09:00 without sending the user into settings first. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- A reboot clears every armed alarm, so being told about it is the only
         way a reminder set for tomorrow survives tonight's restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Fully qualified on purpose: a relative name in a library manifest
             is resolved against the merged application id, which is not this
             module's package. -->
        <receiver
            android:name="dev.local.organizer.reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Exported because these are protected system broadcasts: only the
             system can send them, and from API 31 a receiver with an
             intent-filter has to say so explicitly. -->
        <receiver
            android:name="dev.local.organizer.reminders.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
