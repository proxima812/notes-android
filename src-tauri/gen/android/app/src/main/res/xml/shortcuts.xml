<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's long-press menu.

    One entry, because the feature it opens is the one worth reaching without
    opening the app first: a thought that has to be written down before it goes.
    The intent is caught by the speech plugin, which holds it until the WebView
    exists to ask — a shortcut can start the app cold.

    `android:enabled` is not set per alias: the shortcut belongs to the package,
    and the icon aliases only decide which face the launcher shows.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="dictate"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_dictate"
        android:shortcutShortLabel="@string/shortcut_dictate_short"
        android:shortcutLongLabel="@string/shortcut_dictate_long">
        <intent
            android:action="dev.local.organizer.DICTATE"
            android:targetPackage="dev.local.organizer"
            android:targetClass="dev.local.organizer.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
