<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictated notes. The audio never leaves the recogniser: the plugin asks
         for the on-device model and receives text, and nothing is recorded.

         Edited on purpose in a generated file, like the launcher entry below:
         `tauri android init` rewrites this manifest, so both have to be
         re-checked after it is run. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- One short buzz when the microphone opens and two when the note is
         saved. The case this feature was built for is a phone at your side that
         nobody is looking at, and a screen that changes colour says nothing to
         someone who is walking. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declaring RECORD_AUDIO makes Google Play infer that a microphone is
         *required*, which would hide the app from every device without one —
         including the Android TV boxes the leanback entry below keeps
         supported. Dictation is one button among several, so the microphone is
         optional and the app stays installable without it. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- From Android 11 an app cannot see a service it has not declared, and
         the recogniser is a service in another package. Without this,
         `isRecognitionAvailable` answers false on every modern device. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.notes_android"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <!-- The launcher entry lives on the `activity-alias` entries the
                 appicon plugin contributes, one per icon, so that switching
                 icons is switching which alias is enabled. Leaving one here as
                 well would show the app twice in the launcher, and an alias
                 cannot be shown while its target activity is disabled — so the
                 target cannot keep the entry itself.

                 Edited on purpose in a generated file: `tauri android init`
                 writes this manifest, so re-running it brings the filter back
                 and the aliases have to be re-checked. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
