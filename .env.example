# Образец локального окружения. Скопировать в `.env` и заполнить:
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` в .gitignore — этот файл единственный из двух, который едет в Git, и
# значений в нём быть не должно. Читает его `scripts/android-env.sh`: он же
# собирает из четырёх строк подписи файл
# `src-tauri/gen/android/keystore.properties`, который ждёт Gradle.

# --- Подпись release APK (README, раздел 5) ---
# Путь к .jks и пароли к нему. Потеря keystore означает невозможность выпустить
# обновление поверх установленного APK, поэтому файл стоит держать ещё где-то,
# кроме этой машины.
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Инструменты сборки (README, разделы 1-2) ---
# Пусто — значит взять то, что зашито в scripts/android-env.sh: JDK 21 из
# Homebrew, SDK в ~/Library/Android/sdk и NDK версии ниже.
JAVA_HOME=
ANDROID_HOME=
ANDROID_NDK_VERSION=
